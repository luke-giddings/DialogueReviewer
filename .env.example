# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Anthropic API — used by the bible generator and review engine.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gridly API — used by the Gridly reader.
# Optional: only needed if you're pulling dialogue from a Gridly project.
GRIDLY_API_KEY=
